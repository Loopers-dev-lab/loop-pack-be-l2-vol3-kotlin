{
  "dashboard": {
    "id": null,
    "uid": "circuitbreaker",
    "title": "PG CircuitBreaker 모니터링",
    "tags": ["resilience4j", "circuitbreaker", "payment"],
    "timezone": "Asia/Seoul",
    "refresh": "5s",
    "time": { "from": "now-5m", "to": "now" },
    "panels": [
      {
        "id": 1,
        "title": "서킷브레이커 상태 (0=CLOSED, 1=OPEN, 2=HALF_OPEN)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
        "targets": [
          {
            "expr": "resilience4j_circuitbreaker_state{name=\"pg-simulator\"}",
            "legendFormat": "{{state}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": { "lineWidth": 2, "fillOpacity": 20 },
            "min": -0.5,
            "max": 2.5
          }
        }
      },
      {
        "id": 2,
        "title": "실패율 (%)",
        "type": "gauge",
        "gridPos": { "h": 8, "w": 6, "x": 0, "y": 8 },
        "targets": [
          {
            "expr": "resilience4j_circuitbreaker_failure_rate{name=\"pg-simulator\"}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "steps": [
                { "color": "green", "value": 0 },
                { "color": "yellow", "value": 30 },
                { "color": "red", "value": 50 }
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "호출 결과 (성공/실패/무시)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 18, "x": 6, "y": 8 },
        "targets": [
          {
            "expr": "rate(resilience4j_circuitbreaker_calls_seconds_count{name=\"pg-simulator\", kind=\"successful\"}[30s])",
            "legendFormat": "성공",
            "refId": "A"
          },
          {
            "expr": "rate(resilience4j_circuitbreaker_calls_seconds_count{name=\"pg-simulator\", kind=\"failed\"}[30s])",
            "legendFormat": "실패",
            "refId": "B"
          },
          {
            "expr": "rate(resilience4j_circuitbreaker_calls_seconds_count{name=\"pg-simulator\", kind=\"not_permitted\"}[30s])",
            "legendFormat": "차단 (OPEN)",
            "refId": "C"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": { "lineWidth": 2, "fillOpacity": 30 }
          }
        }
      },
      {
        "id": 4,
        "title": "Retry 횟수",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
        "targets": [
          {
            "expr": "rate(resilience4j_retry_calls_total{name=\"pg-simulator\", kind=\"successful_without_retry\"}[30s])",
            "legendFormat": "재시도 없이 성공",
            "refId": "A"
          },
          {
            "expr": "rate(resilience4j_retry_calls_total{name=\"pg-simulator\", kind=\"successful_with_retry\"}[30s])",
            "legendFormat": "재시도 후 성공",
            "refId": "B"
          },
          {
            "expr": "rate(resilience4j_retry_calls_total{name=\"pg-simulator\", kind=\"failed_with_retry\"}[30s])",
            "legendFormat": "재시도 후 실패",
            "refId": "C"
          }
        ]
      },
      {
        "id": 5,
        "title": "결제 API 응답 시간 (p50 / p95 / p99)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(http_server_requests_seconds_bucket{uri=\"/api/v1/payments\", method=\"POST\"}[30s]))",
            "legendFormat": "p50",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, rate(http_server_requests_seconds_bucket{uri=\"/api/v1/payments\", method=\"POST\"}[30s]))",
            "legendFormat": "p95",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.99, rate(http_server_requests_seconds_bucket{uri=\"/api/v1/payments\", method=\"POST\"}[30s]))",
            "legendFormat": "p99",
            "refId": "C"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        }
      },
      {
        "id": 6,
        "title": "슬라이딩 윈도우 버퍼 호출 수",
        "type": "stat",
        "gridPos": { "h": 4, "w": 8, "x": 0, "y": 24 },
        "targets": [
          {
            "expr": "resilience4j_circuitbreaker_buffered_calls{name=\"pg-simulator\"}",
            "legendFormat": "{{kind}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 7,
        "title": "초당 요청 수 (RPS)",
        "type": "timeseries",
        "gridPos": { "h": 4, "w": 16, "x": 8, "y": 24 },
        "targets": [
          {
            "expr": "rate(http_server_requests_seconds_count{uri=\"/api/v1/payments\", method=\"POST\"}[30s])",
            "legendFormat": "결제 요청 RPS",
            "refId": "A"
          }
        ]
      }
    ]
  },
  "overwrite": true
}
