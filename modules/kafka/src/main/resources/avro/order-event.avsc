{
  "type": "record",
  "name": "OrderEvent",
  "namespace": "com.loopers.avro",
  "fields": [
    {"name": "eventId", "type": "string"},
    {"name": "eventType", "type": "string"},
    {"name": "orderId", "type": "long"},
    {"name": "userId", "type": "long"},
    {"name": "totalAmount", "type": ["null", "long"], "default": null},
    {"name": "itemCount", "type": ["null", "int"], "default": null},
    {"name": "items", "type": ["null", {"type": "array", "items": {
      "type": "record",
      "name": "OrderEventItem",
      "fields": [
        {"name": "productId", "type": "long"},
        {"name": "quantity", "type": "int"},
        {"name": "salesAmount", "type": "long"}
      ]
    }}], "default": null},
    {"name": "occurredAt", "type": "string"}
  ]
}
