{
  "permissions": {
    "deny": [
      "Bash(*gh pr merge*)",
      "Bash(*git push --force*)",
      "Bash(*git push -f*)",
      "Bash(*git reset --hard*)",
      "Bash(*git checkout -- .)",
      "Bash(*git clean -f*)",
      "Bash(*rm -rf *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/pre-tool-guard.sh" }
        ]
      }
    ]
  }
}
